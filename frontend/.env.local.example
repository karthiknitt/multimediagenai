# Database
DATABASE_URL=                    # Neon PostgreSQL connection string

# Auth
BETTER_AUTH_SECRET=             # Session encryption key (use: openssl rand -base64 32)
BETTER_AUTH_URL=                # Base URL for callbacks (e.g., http://localhost:3000)
BETTER_AUTH_TRUSTED_ORIGINS=    # Optional comma-separated extra origins (e.g. Tailscale IP / MagicDNS URL)

# Storage
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=                  # Public URL for R2 bucket

# Modal endpoints (from `modal deploy` output in backend/*-gen)
IMAGE_GEN_API_URL=              # image-generation (Z-Image-Turbo)  https://<workspace>--image-generation-imagegenerator-generate.modal.run
VIDEO_GEN_TEXT2VIDEO_API_URL=   # video-generation (Wan2.2 T2V-A14B) ...videogenerator-generate-text2video.modal.run
VIDEO_GEN_IMG2VIDEO_API_URL=    # video-generation (Wan2.2 I2V-A14B) ...videogenerator-generate-img2video.modal.run
AUDIO_GEN_API_URL=              # audio-generation (ACE-Step 1.5)    ...audiogenerator-generate.modal.run
TTS_GEN_API_URL=                # tts-generation (Qwen3-TTS)         ...ttsgenerator-generate.modal.run
# Modal proxy-auth token (Modal dashboard > Settings > Proxy Auth Tokens); required by all endpoints
MODAL_PROXY_TOKEN_ID=
MODAL_PROXY_TOKEN_SECRET=

# Monitoring
SENTRY_DSN=                     # Error tracking

# Rate Limiting
RATE_LIMIT_FREE_TIER=10         # Free tier generations per day
