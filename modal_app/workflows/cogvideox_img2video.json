      "description": "Text description of the desired motion/animation",
      "example": "a majestic stag is grazing in an enhanced forest, basking in the setting sun filtered by the trees",
      "required": true
    },
    "NEGATIVE_PROMPT": {
      "type": "string",
      "description": "What to avoid in the animation (leave empty for default)",
      "default": "",
      "required": false
    },
    "WIDTH": {
      "type": "integer",
      "description": "Video width in pixels (must be multiple of 16)",
      "default": 1360,
      "min": 720,
      "max": 1920,
      "required": true
    },
    "HEIGHT": {
      "type": "integer",
      "description": "Video height in pixels (must be multiple of 16)",
      "default": 768,
      "min": 480,
      "max": 1080,
      "required": true
    },
    "NUM_FRAMES": {
      "type": "integer",
      "description": "Number of frames to generate",
      "default": 49,
      "min": 25,
      "max": 81,
      "required": true
    },
    "FPS": {
      "type": "integer",
      "description": "Frames per second",
      "default": 16,
      "options": [8, 16, 24],
      "required": true
    },
    "STEPS": {
      "type": "integer",
      "description": "Number of denoising steps (more = better quality, slower)",
      "default": 25,
      "min": 10,
      "max": 50,
      "required": true
    },
    "CFG_SCALE": {
      "type": "float",
      "description": "Classifier-free guidance scale (higher = more prompt adherence)",
      "default": 6.0,
      "min": 1.0,
      "max": 15.0,
      "required": true
    },
    "SEED": {
      "type": "integer",
      "description": "Random seed for reproducibility (0 for random)",
      "default": 0,
      "required": true
    },
    "OUTPUT_PREFIX": {
      "type": "string",
      "description": "Prefix for output filename",
      "default": "cogvideox_i2v_output",
      "required": true
    }
