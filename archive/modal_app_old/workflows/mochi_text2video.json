  "_parameter_reference": {
    "PROMPT": {
      "type": "string",
      "description": "Text description of the video to generate",
      "example": "nature video of a red panda eating bamboo in front of a waterfall",
      "required": true
    },
    "NEGATIVE_PROMPT": {
      "type": "string",
      "description": "What to avoid in the generation (leave empty for default)",
      "default": "",
      "required": false
    },
    "WIDTH": {
      "type": "integer",
      "description": "Video width in pixels (must be multiple of 16)",
      "default": 848,
      "min": 512,
      "max": 1280,
      "required": true
    },
    "HEIGHT": {
      "type": "integer",
      "description": "Video height in pixels (must be multiple of 16)",
      "default": 480,
      "min": 480,
      "max": 720,
      "required": true
    },
    "NUM_FRAMES": {
      "type": "integer",
      "description": "Number of frames to generate (more frames = longer video)",
      "default": 49,
      "min": 25,
      "max": 163,
      "required": true
    },
    "FPS": {
      "type": "integer",
      "description": "Frames per second",
      "default": 30,
      "options": [24, 30],
      "required": true
    },
    "SEED": {
      "type": "integer",
      "description": "Random seed for reproducibility (-1 for random)",
      "default": -1,
      "required": true
    },
    "CFG_SCALE": {
      "type": "float",
      "description": "Classifier-free guidance scale (higher = more prompt adherence)",
      "default": 4.5,
      "min": 1.0,
      "max": 10.0,
      "required": true
    },
    "OUTPUT_PREFIX": {
      "type": "string",
      "description": "Prefix for output filename",
      "default": "mochi_output",
      "required": true
    },
    "JOB_ID": {
      "type": "string",
      "description": "Unique job identifier for latent saving",
      "required": true
    }
  }
